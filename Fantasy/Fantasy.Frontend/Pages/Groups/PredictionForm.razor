    <EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
        <DataAnnotationsValidator />

        <!-- Contenedor principal responsive -->
        <MudStack Row="false" Spacing="4" Class="my-4">

            <!-- Primera fila: Local (imagen + nombre) -->
            <MudStack Row="true" Align="Align.Center" Justify="Justify.Center" Spacing="2">
                <MudImage Src="@match.Local.ImageFull" Width="80" Height="48" />
                <MudText Typo="Typo.h6" Align="Align.Center">@match.Local.Name</MudText>
            </MudStack>

            <!-- Segunda fila: Goals local + Vs + Goals visitor (en fila o columna según pantalla) -->
            <MudStack Row="true" Justify="Justify.Center" Align="Align.Center" Spacing="2"
                      Breakpoint="Breakpoint.Sm">
                <!-- En pantallas < sm, se apila verticalmente -->
                <MudTextField @bind-Value="@PredictionDTO.GoalsLocal" For="@(() => PredictionDTO.GoalsLocal)"
                              InputType="InputType.Number"
                              Adornment="Adornment.Start"
                              Style="font-size: 32px; text-align: center; width: 100px;"
                              Class="mb-2" @onblur="ValidateInput" />

                <MudText Typo="Typo.h4" Align="Align.Center">Vs.</MudText>

                <MudTextField @bind-Value="@PredictionDTO.GoalsVisitor" For="@(() => PredictionDTO.GoalsVisitor)"
                              InputType="InputType.Number"
                              Adornment="Adornment.Start"
                              Style="font-size: 32px; text-align: center; width: 100px;"
                              Class="mb-2" @onblur="ValidateInput" />
            </MudStack>

            <!-- Tercera fila: Visitor (imagen + nombre) -->
            <MudStack Row="true" Align="Align.Center" Justify="Justify.Center" Spacing="2">
                <MudImage Src="@match.Visitor.ImageFull" Width="80" Height="48" />
                <MudText Typo="Typo.h6" Align="Align.Center">@match.Visitor.Name</MudText>
            </MudStack>

        </MudStack>

        <!-- Botones también responsivos -->
        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info"
                       OnClick="ReturnAction" FullWidth="true" Breakpoint="Breakpoint.Sm">
                @Localizer["Return"]
            </MudButton>

            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Check" Color="Color.Primary"
                       ButtonType="ButtonType.Submit" FullWidth="true" Breakpoint="Breakpoint.Sm">
                @Localizer["SaveChanges"]
            </MudButton>
        </MudStack>
    </EditForm>
}
